[Unit]
Description=Agoge controlled Symphony GitHub orchestrator
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3
[Service]
Type=simple
WorkingDirectory=/home/toluadmin/services/symphony/elixir
EnvironmentFile=/home/toluadmin/.config/symphony/agoge.env
Environment=PATH=/home/toluadmin/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment="ERL_FLAGS=+S 2:2"
ExecStart=/home/toluadmin/.local/bin/mise exec -- ./bin/symphony /home/toluadmin/services/symphony-configs/agoge-business-systems/WORKFLOW.md --port 4000 --logs-root /home/toluadmin/services/symphony-logs/agoge --i-understand-that-this-will-be-running-without-the-usual-guardrails
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=30
UMask=0077
[Install]
WantedBy=default.target
